diff --git a/Makefile.libretro b/Makefile.libretro
index b2f0faf..5285435 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -1,6 +1,11 @@
 
 PLATFLAGS :=
 
+DEPS_PREFIX ?=
+UAE4ARM_EXTERNAL_CODECS ?= auto
+BUILD_CAPSIMG ?= 1
+CC_AS ?= $(CC)
+
 ifeq ($(platform),)
 platform = unix
 endif
@@ -10,8 +15,48 @@ TARGET_NAME := uae4arm
 CORE_DIR  := .
 ROOT_DIR  := .
 
+ifeq ($(platform), android-armv7)
+	TARGET := $(TARGET_NAME)_libretro_android.so
+	fpic := -fPIC
+	SHARED := -shared -Wl,--version-script=$(CORE_DIR)/libretro/link.T -Wl,--no-undefined -Wl,--fix-cortex-a8
+	CPU_FLAGS += -march=armv7-a -marm -mfpu=neon -mfloat-abi=softfp
+	MORE_CFLAGS += -DARMV6T2 -DARM_HAS_DIV
+	PLATFLAGS += -DANDROID -DRETRO -DAND -DANDPORT -DARM_OPT_TEST=1 -D_FILE_OFFSET_BITS=64
+	LDFLAGS := -lz -lm -llog -ldl
+	HAVE_NEON = 1
+	USE_PICASSO96 = 1
+	CONFIGURE_EXTERNAL_CODECS = 1
+	BUILD_CAPSIMG = 0
+	STRICT_CXX = 1
+else ifeq ($(platform), android-aarch64)
+	TARGET := $(TARGET_NAME)_libretro_android.so
+	fpic := -fPIC
+	SHARED := -shared -Wl,--version-script=$(CORE_DIR)/libretro/link.T -Wl,--no-undefined
+	MORE_CFLAGS += -DCPU_AARCH64
+	PLATFLAGS += -DANDROID -DRETRO -DAND -DANDPORT -DARM_OPT_TEST=1 -D_FILE_OFFSET_BITS=64
+	LDFLAGS := -lz -lm -llog -ldl
+	AARCH64 = 1
+	CONFIGURE_EXTERNAL_CODECS = 1
+	BUILD_CAPSIMG = 0
+	STRICT_CXX = 1
+else ifeq ($(platform), osx-arm64)
+	TARGET := $(TARGET_NAME)_libretro.dylib
+	fpic := -fPIC
+	SHARED := -dynamiclib
+	MORE_CFLAGS += -DCPU_AARCH64
+	APPLE_FLAGS := -arch arm64 $(MINVERSION)
+	ifeq ($(CROSS_COMPILE), 1)
+		APPLE_FLAGS += -target $(LIBRETRO_APPLE_PLATFORM) -isysroot $(LIBRETRO_APPLE_ISYSROOT)
+	endif
+	CFLAGS += $(APPLE_FLAGS)
+	ASFLAGS += $(APPLE_FLAGS)
+	LDFLAGS := $(APPLE_FLAGS) -lz
+	AARCH64 = 1
+	CONFIGURE_EXTERNAL_CODECS = 1
+	BUILD_CAPSIMG = 0
+	STRICT_CXX = 1
 	# Default (ARM) unix
-ifneq (,$(findstring unix,$(platform)))
+else ifneq (,$(findstring unix,$(platform)))
 	TARGET := $(TARGET_NAME)_libretro.so
 	fpic := -fPIC
 	LDFLAGS := -lz -lpthread -lFLAC -lmpg123 -ldl
@@ -181,6 +226,38 @@ else ifeq ($(platform), android)
 	PLATFLAGS += -DANDROID -DRETRO -DAND -DANDPORT -DARM_OPT_TEST=1
 endif
 
+ifeq ($(CONFIGURE_EXTERNAL_CODECS), 1)
+	EXTERNAL_CODECS_ENABLED := 0
+	ifneq (,$(filter 1 yes true,$(UAE4ARM_EXTERNAL_CODECS)))
+		EXTERNAL_CODECS_ENABLED := 1
+	else ifeq ($(UAE4ARM_EXTERNAL_CODECS), auto)
+		ifneq ($(strip $(DEPS_PREFIX)),)
+			ifneq ($(wildcard $(DEPS_PREFIX)/lib/libFLAC.a),)
+				ifneq ($(wildcard $(DEPS_PREFIX)/lib/libmpg123.a),)
+					EXTERNAL_CODECS_ENABLED := 1
+				endif
+			endif
+		endif
+	else ifneq (,$(filter 0 no false,$(UAE4ARM_EXTERNAL_CODECS)))
+	else
+		$(error UAE4ARM_EXTERNAL_CODECS must be auto, 0/1, no/yes, or false/true)
+	endif
+
+	ifeq ($(EXTERNAL_CODECS_ENABLED), 1)
+		ifneq ($(strip $(DEPS_PREFIX)),)
+			EXTRA_INCLUDES += -I$(DEPS_PREFIX)/include
+			LDFLAGS += -L$(DEPS_PREFIX)/lib
+		endif
+		LDFLAGS += -lFLAC -lmpg123
+		ifneq ($(wildcard $(DEPS_PREFIX)/lib/libogg.a),)
+			LDFLAGS += -logg
+		endif
+		LDFLAGS += -lz -lm
+	else
+		MORE_CFLAGS += -DUAE4ARM_NO_EXTERNAL_CODECS
+	endif
+endif
+
 # webOS
 ifneq (,$(or $(findstring webos,$(CROSS_COMPILE)),$(findstring starfish,$(CROSS_COMPILE))))
 	CPU_FLAGS += -D__arm__
@@ -223,7 +300,10 @@ endif
 
 DEFINES += -D__LIBRETRO__ $(DEFS) $(MORE_CFLAGS)
 #-std=gnu99 
-CFLAGS += $(DEFINES) -DINLINE="inline" $(CPU_FLAGS) -fexceptions -fpermissive
+CFLAGS += $(DEFINES) -DINLINE="inline" $(CPU_FLAGS) -fexceptions
+ifneq ($(STRICT_CXX), 1)
+	CXXFLAGS += -fpermissive
+endif
 
 include Makefile.common
 
@@ -237,35 +317,40 @@ ASFLAGS += $(CPU_FLAGS)
 
 all: $(TARGET)
 
-CAPS = capsimg.so
+CAPS :=
+ifeq ($(BUILD_CAPSIMG), 1)
+	CAPS := capsimg.so
 
 capsimg.so: capsimg
 	(cd capsimg ; ./bootstrap ; ./configure --host=arm ; $(MAKE) ; cp capsimg.so ../ )
+endif
 
 $(TARGET): $(OBJECTS) $(CAPS)
 	$(CXX) $(fpic) $(SHARED) $(INCDIRS) -o $@ $(OBJECTS) $(LDFLAGS)
 
 $(EMU)/od-pandora/neon_helper.o: $(EMU)/od-pandora/neon_helper.s
-	$(CXX) $(ASFLAGS) -Wall -o $(EMU)/od-pandora/neon_helper.o -c $(EMU)/od-pandora/neon_helper.s
+	$(CC_AS) $(fpic) $(ASFLAGS) $(PLATFLAGS) -Wall -o $@ -c $<
 
 $(EMU)/od-pandora/arm_helper.o: $(EMU)/od-pandora/arm_helper.s
-	$(CXX) $(ASFLAGS) -Wall -o $(EMU)/od-pandora/arm_helper.o -c $(EMU)/od-pandora/arm_helper.s
+	$(CC_AS) $(fpic) $(ASFLAGS) $(PLATFLAGS) -Wall -o $@ -c $<
 
 $(EMU)/od-pandora/aarch64_helper.o: $(EMU)/od-pandora/aarch64_helper.s
-	$(CXX) $(ASFLAGS) -Wall -o $(EMU)/od-pandora/aarch64_helper.o -c $(EMU)/od-pandora/aarch64_helper.s
+	$(CC_AS) $(fpic) $(ASFLAGS) $(PLATFLAGS) -x assembler-with-cpp -Wall -o $@ -c $<
 
 %.o: %.cpp
-	$(CXX) $(fpic) $(CFLAGS) $(PLATFLAGS) $(INCDIRS) -c -o $@ $<
+	$(CXX) $(fpic) $(CFLAGS) $(CXXFLAGS) $(PLATFLAGS) $(INCDIRS) -c -o $@ $<
 
 %.o: %.c
 	$(CC) $(fpic) $(CFLAGS) $(PLATFLAGS) $(INCDIRS) -c -o $@ $<
 
 %.o: %.S
-	$(CC_AS) $(CFLAGS)  $(PLATFLAGS) -c $^ -o $@
+	$(CC_AS) $(fpic) $(ASFLAGS) $(PLATFLAGS) -c $< -o $@
 
 clean:
 	rm -f $(OBJECTS) $(TARGET) 
+
+ifeq ($(BUILD_CAPSIMG), 1)
 	(cd capsimg ; make clean )
+endif
 
 .PHONY: clean
