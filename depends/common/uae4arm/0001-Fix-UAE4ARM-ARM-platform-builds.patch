 #if defined(CPU_AARCH64)
 
+#ifdef __APPLE__
+typedef mcontext_t uae_mcontext_t;
+
+static uae_mcontext_t get_mcontext(ucontext_t *ucontext)
+{
+  return ucontext->uc_mcontext;
+}
+
+static uintptr_t get_pc(uae_mcontext_t context)
+{
+  return context->__ss.__pc;
+}
+
+static void advance_pc(uae_mcontext_t context)
+{
+  context->__ss.__pc += 4;
+}
+
+static uae_u64 get_register(uae_mcontext_t context, int reg)
+{
+  if (reg < 29)
+    return context->__ss.__x[reg];
+  if (reg == 29)
+    return context->__ss.__fp;
+  if (reg == 30)
+    return context->__ss.__lr;
+  return 0;
+}
+
+static void set_register(uae_mcontext_t context, int reg, uae_u64 value)
+{
+  if (reg < 29)
+    context->__ss.__x[reg] = value;
+  else if (reg == 29)
+    context->__ss.__fp = value;
+  else if (reg == 30)
+    context->__ss.__lr = value;
+}
+
+static uintptr_t get_sp(uae_mcontext_t context)
+{
+  return context->__ss.__sp;
+}
+
+static uintptr_t get_fault_address(uae_mcontext_t context)
+{
+  return context->__es.__far;
+}
+
+static unsigned int get_pstate(uae_mcontext_t context)
+{
+  return context->__ss.__cpsr;
+}
+#else
+typedef mcontext_t *uae_mcontext_t;
+
+static uae_mcontext_t get_mcontext(ucontext_t *ucontext)
+{
+  return &ucontext->uc_mcontext;
+}
+
+static uintptr_t get_pc(uae_mcontext_t context)
+{
+  return context->pc;
+}
+
+static void advance_pc(uae_mcontext_t context)
+{
+  context->pc += 4;
+}
+
+static uae_u64 get_register(uae_mcontext_t context, int reg)
+{
+  return context->regs[reg];
+}
+
