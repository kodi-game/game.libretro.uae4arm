From 5b8d5b85566ba18f83eab2fdf8ae38a3758831cb Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Fri, 21 Aug 2026 20:28:09 -0700
Subject: [PATCH] Fix UAE4ARM ARM platform builds

Build UAE4ARM only on the supported Android ARM and macOS ARM64
platforms, and use its Makefile directly instead of the stale JNI path.

Add ARMv7, AArch64 and macOS ARM64 platform handling, forward Kodi's
compilers and deployment target, and apply the portability fixes needed
by the older UAE4ARM source tree.

Use Kodi's staged FLAC and mpg123 libraries when available, while
preserving existing generator behavior for unrelated cores.
---
 Makefile.libretro                  |  45 ++++++++-
 libretro/libco/aarch64.c           |   5 +-
 src/blkdev_cdimage.cpp             |  16 +++-
 src/expansion.cpp                  |   3 +-
 src/newcpu_common.cpp              |   2 +-
 src/od-pandora/aarch64_helper.s    |  78 ++++++++--------
 src/od-pandora/bsdsocket_host.cpp  |   2 +-
 src/od-pandora/mp3decoder.cpp      |   6 ++
 src/od-pandora/pandora.cpp         |   4 +-
 src/od-pandora/retro_gfx.cpp       |   2 +
 src/od-pandora/sigsegv_handler.cpp | 143 ++++++++++++++++++++++++-----
 src/od-pandora/sysconfig.h         |  10 +-
 12 files changed, 243 insertions(+), 73 deletions(-)

diff --git a/Makefile.libretro b/Makefile.libretro
index b2f0faf..5e27893 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -179,6 +179,37 @@ else ifeq ($(platform), android)
 	LDFLAGS := -lz -lm -llog
 	SHARED :=  -Wl,--fix-cortex-a8 -shared -Wl,--version-script=$(CORE_DIR)/libretro/link.T -Wl,--no-undefined
 	PLATFLAGS += -DANDROID -DRETRO -DAND -DANDPORT -DARM_OPT_TEST=1
+else ifneq (,$(filter android-armv7 android-aarch64,$(platform)))
+	TARGET := $(TARGET_NAME)_libretro_android.so
+	fpic := -fPIC
+	LDFLAGS := -lz -lm -llog
+	SHARED := -shared -Wl,--version-script=$(CORE_DIR)/libretro/link.T -Wl,--no-undefined
+	PLATFLAGS += -DANDROID -DRETRO -DAND -DANDPORT -DARM_OPT_TEST=1 -DUAE4ARM_NO_EXTERNAL_CODECS
+	ifeq ($(platform), android-aarch64)
+		AARCH64 = 1
+		MORE_CFLAGS += -DCPU_AARCH64
+	else
+		MORE_CFLAGS += -DARMV6T2 -DARM_HAS_DIV
+		HAVE_NEON = 1
+		USE_PICASSO96 = 1
+		CPU_FLAGS += -marm
+		SHARED += -Wl,--fix-cortex-a8
+	endif
+else ifeq ($(platform), osx-arm64)
+	TARGET := $(TARGET_NAME)_libretro.dylib
+	fpic := -fPIC
+	LDFLAGS := -lz
+	SHARED := -dynamiclib
+	AARCH64 = 1
+	MORE_CFLAGS += -DCPU_AARCH64
+	CXXFLAGS += -std=gnu++11 -Wno-c++11-narrowing
+	PLATFLAGS += -Dstat64=stat -Dftello64=ftello -Dfseeko64=fseeko -DUAE4ARM_NO_EXTERNAL_CODECS
+	ifeq ($(CROSS_COMPILE), 1)
+		TARGET_RULE := -target $(LIBRETRO_APPLE_PLATFORM) -isysroot $(LIBRETRO_APPLE_ISYSROOT)
+		CFLAGS += $(TARGET_RULE) $(MINVERSION)
+		ASFLAGS += $(TARGET_RULE) $(MINVERSION)
+		LDFLAGS += $(TARGET_RULE) $(MINVERSION)
+	endif
 endif
 
 # webOS
@@ -211,7 +242,10 @@ ifneq ($(AARCH64), 1)
