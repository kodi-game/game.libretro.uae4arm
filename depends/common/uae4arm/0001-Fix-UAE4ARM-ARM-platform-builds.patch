+// Load an interposable symbol through the GOT so this object remains valid in
+// a shared library.  The literal is placed where the add instruction sees it
+// as its PC value, avoiding an absolute text relocation.
+.macro load_external reg, symbol
+  ldr       \reg, 1f
+  add       \reg, pc, \reg
+  b         2f
+1:
+  .word     \symbol(GOT_PREL)
+2:
+  ldr       \reg, [\reg]
+.endm
+
+// Local tables only need a section-relative offset.
+.macro load_local reg, symbol
+  ldr       \reg, 1f
+  add       \reg, pc, \reg
+  b         2f
+1:
+  .word     \symbol - .
+2:
+.endm
+
 @----------------------------------------------------------------
 @ save_host_fp_regs
